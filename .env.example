# Public API base URL (not a secret — it is exposed in the browser bundle).
# Local dev: leave empty and use Vite proxy for /api and /uploads, or set:
# VITE_API_BASE_URL=http://localhost:5000
#
# Never put JWT_SECRET, database URIs, or R2 keys here; only VITE_* vars are bundled.
VITE_API_BASE_URL=
